{
  "name": "vexyl-web",
  "version": "0.1.0",
  "private": true,
  "description": "The Vexyl flag editor, as static files",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=${VEXYL_TEST_JOBS:-4} test/unit/*.test.mjs",
    "e2e": "node --test --test-concurrency=${VEXYL_TEST_JOBS:-4} --test-timeout=900000 test/e2e/*.test.mjs"
  },
  "dependencies": {
    "@bgotink/kdl": "0.4.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "fflate": "0.8.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
