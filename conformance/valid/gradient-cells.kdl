vexyl 1
meta {
  name "Gradient cells"
  description "A gradient on a quarter, a check or a wedge spans that cell, not the region"
}
palette {
  dark "#112244"
  pale "#ddeeff"
  gold "#ffcc00"
  shade gradient dark pale
}
proportion hoist=20 fly=40
quarters shade gold gold shade
panel {
  corner upper-hoist
  fly 20
  hoist 10
  checks shade gold {
    rows 2
    columns 4
  }
}
panel {
  corner lower-fly
  fly 20
  hoist 10
  rays shade gold {
    count 6
  }
}
