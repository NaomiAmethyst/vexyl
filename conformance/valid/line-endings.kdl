vexyl 1
meta {
  name "Line endings"  description """
    A file saved on another system.
    Its multi-line strings read the same.
    """
  license "CC0-1.0"
}
palette {
  blue "#0044aa"  gold "#ffcc00"
}
proportion hoist=10 fly=20
field bluecharge svg {
  at fly=10 hoist=5
  fly 8
  hoist 8
  markup #"""
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">
      <path fill="#ffcc00" d="M1 1
        H9 V9        H1 Z"/>
    </svg>
    """#
}
