vexyl 1
meta {
  name "Options"
  description "A flag with something for every option to ask of it"
}
palette {
  a "#112233"
  b "#445566"
}
proportion hoist=10 fly=20
define art {
  charge disc a {
    radius 1
    clip {
      rect {
        fly 1
        hoist 1
      }
    }
  }
}
field b
use art
adapt {
  wider extend
  narrower extend
}
variant long {
  ratio 3
}
variant plain {
  from none
}
variant turned {
  from rotate
}
fold half {
  over along=hoist at=10 move=fly
  under along=fly at=5 move=top
}
