// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Genderfluidity Pride-Flag"
  encoder "JJ Pole.McLennonSonGarethPW"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Genderfluidity_Pride-Flag.svg"
}
palette {
  pink "#ff75a2"
  pink-2 "#be18d6"
  blue "#333ebd"
}
proportion hoist=480 fly=800

charge svg {
  at center
  fly 800
  hoist 480
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480"><rect height="98" rx="1" y="95" width="800" fill="#f5f5f5" transform="matrix(1 0 0 1 0 0)"/><rect height="98" rx="1" y="287" width="800" fill="#2c2c2c" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

charge rect pink {
  fly 800
  hoist 96
  at fly=400 hoist=48
}

charge rect pink-2 {
  fly 800
  hoist 96
  at fly=400 hoist=240
}

charge rect blue {
  fly 800
  hoist 96
  at fly=400 hoist=432
}
