// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Straight Ally Flag (Prism)"
  encoder "Femfem5"
  license "CC0-1.0"
  source "https://commons.wikimedia.org/wiki/File:Straight_Ally_Flag_(Prism).svg"
}
palette {
  black "#000000"
  white "#ffffff"
  orange "#ff8c00"
  green "#008026"
  blue "#004dff"
  pink "#750787"
  yellow "#ffed00"
}
proportion hoist=1000 fly=1500

chevrons black {
  depth 750
}

charge polygon black {
  point fly=1500 hoist=1000
  point fly=750 hoist=500
  point fly=1500 hoist=0
}

charge polygon white {
  point fly=0 hoist=1000
  point fly=750 hoist=500
  point fly=1500 hoist=1000
  point fly=0 hoist=1000.0001
}

charge svg {
  at center
  fly 1500
  hoist 1000
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1500 1000"><path d="m750 500-750-500h250s500 500 500 500" fill="#e40303" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

charge polygon orange {
  point fly=750 hoist=500
  point fly=250 hoist=0
  point fly=500 hoist=0
}

charge polygon green {
  point fly=750 hoist=500
  point fly=750 hoist=0
  point fly=1000 hoist=0
}

charge polygon blue {
  point fly=750 hoist=500
  point fly=1000 hoist=0
  point fly=1250 hoist=0
}

charge polygon pink {
  point fly=750 hoist=500
  point fly=1250 hoist=0
  point fly=1500 hoist=-0.0001
  point fly=750 hoist=499.9999
}

charge polygon yellow {
  point fly=750 hoist=500
  point fly=500 hoist=0
  point fly=750 hoist=0
}
