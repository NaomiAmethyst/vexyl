// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Maldives"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Maldives.svg"
}
palette {
  white "#ffffff"
  green "#007e3a"
}
proportion hoist=480 fly=720

charge svg {
  at center
  fly 720
  hoist 480
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 480"><rect height="360" x="60" y="60" width="600" stroke="#d21034" stroke-width="120" fill="#007e3a" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

charge disc white {
  radius 80
  at fly=390 hoist=240
}

charge disc green {
  radius 80
  at fly=420 hoist=240
}
