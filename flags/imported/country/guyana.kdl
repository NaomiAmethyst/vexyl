// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Guyana"
  encoder "Whitney Smith"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Guyana.svg"
}
palette {
  green "#2a936a"
}
proportion hoist=60 fly=100

field green

charge svg {
  at center
  fly 100
  hoist 60
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 60"><defs><clipPath id="b"><path d="m0 0 50 30L0 60z"></path></clipPath><clipPath id="w"><path d="m0 0 100 30L0 60z"></path></clipPath></defs><path d="m0 0 100 30L0 60" stroke="#ffffff" stroke-width="4" fill="#ffc20e" clip-path="url(#w)" transform="matrix(1 0 0 1 0 0)"/><path d="m0 0 50 30L0 60" stroke="#000000" stroke-width="4" fill="#be1e2d" clip-path="url(#b)" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}
