// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Benin"
  encoder "Drawn by User:SKopp, rewritten by User:Gabbe"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Benin.svg"
