  point fly=0 hoist=600
  point fly=600 hoist=0
  point fly=900 hoist=0
  point fly=900 hoist=600
}

charge polygon red {
  point fly=900 hoist=0
  point fly=900 hoist=600
  point fly=300 hoist=600
}
