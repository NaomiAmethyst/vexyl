  point fly=6 hoist=4
  point fly=12 hoist=6
  point fly=12 hoist=8
  point fly=0 hoist=8
  point fly=0 hoist=6
}

charge star yellow {
  radius 0.9
  at fly=2 hoist=1.0859
}

charge rect green {
  fly 12
  hoist 2
  at fly=6 hoist=5
}

charge rect pink {
  fly 2
  hoist 8
  at fly=6 hoist=4
}
