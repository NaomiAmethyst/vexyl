// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of South Africa"
  encoder "Flag design by Frederick Brownell, image by Wikimedia Commons users"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_South_Africa.svg"
}
palette {
  red "#e03c31"
  blue "#001489"
}
proportion hoist=60 fly=90

charge polygon red {
  point fly=0 hoist=0
  point fly=90 hoist=0
  point fly=90 hoist=30
  point fly=45 hoist=30
}

charge polygon blue {
  point fly=0 hoist=60
  point fly=90 hoist=60
  point fly=90 hoist=30
  point fly=45 hoist=30
}

charge svg {
  at center
  fly 90
  hoist 60
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 90 60"><defs><clipPath id="t"><path d="m0 0 45 30L0 60z"></path></clipPath></defs><path d="m90 30H45L0 0v60l45-30" stroke="#ffffff" stroke-width="20" fill="none" transform="matrix(1 0 0 1 0 0)"/><path d="m0 0 45 30L0 60" stroke="#ffb81c" stroke-width="20" fill="#000000" clip-path="url(#t)" transform="matrix(1 0 0 1 0 0)"/><path d="m0 0 45 30h45M0 60l45-30" stroke="#007749" stroke-width="12" fill="none" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}
