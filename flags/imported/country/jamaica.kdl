// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Jamaica"
  encoder "The SVG code is valid. This vector image was created with Inkscape by SKopp, and then manually edited by Zscout370, Madd"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Jamaica.svg"
}
palette {
  green "#007749"
}
proportion hoist=6 fly=12

field green

charge svg {
  at center
  fly 12
  hoist 6
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 6"><defs><clipPath id="f"><path d="m0 0h12v6H0z"></path></clipPath></defs><path d="m-2-1v8l16-8v8z" stroke="#ffb81c" fill="#2d2926" clip-path="url(#f)" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}
