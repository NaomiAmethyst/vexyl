// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Tanzania"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Tanzania.svg"
}
palette {
  green "#1eb53a"
  blue "#00a3dd"
  yellow "#fcd116"
  black "#000000"
}
proportion hoist=48 fly=72

charge polygon green {
  point fly=0 hoist=48
  point fly=0 hoist=0
  point fly=72 hoist=0
}

charge polygon blue {
  point fly=72 hoist=0
  point fly=72 hoist=48
  point fly=0 hoist=48
}

band yellow {
  along bend-sinister
  width 19
}

band black {
  along bend-sinister
  width 13
}
