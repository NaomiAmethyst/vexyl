// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Taiwan"
  encoder "Sun Yat-sen"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_Republic_of_China.svg"
}
palette {
  red "#fe0000"
  blue "#000094"
}
proportion hoist=80 fly=120

field red

charge rect blue {
  fly 60
  hoist 40
  at fly=30 hoist=20
}

charge svg {
  at center
  fly 120
  hoist 80
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80"><path d="M30 5l4 15-4 15-4-15zM15 20l15 4 15-4-15-4z" fill="#ffffff" transform="matrix(1 0 0 1 0 0)"/><path d="M30 5l4 15-4 15-4-15zM15 20l15 4 15-4-15-4z" fill="#ffffff" transform="matrix(0.866025 0.5 -0.5 0.866025 14.019238 -12.320508)"/><path d="M30 5l4 15-4 15-4-15zM15 20l15 4 15-4-15-4z" fill="#ffffff" transform="matrix(0.5 0.866025 -0.866025 0.5 32.320508 -15.980762)"/><circle r="8" cy="20" cx="30" stroke="#000094" fill="#ffffff" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}
