// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of the United Kingdom (1-2)"
  encoder "Original: Acts of Union 1800 Vector: Zscout370"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_United_Kingdom_(1-2).svg"
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=30 fly=60

field blue

band white {
  along bend
  width 6
}

band white {
  along bend-sinister
  width 6
}

charge svg {
  at center
  fly 60
  hoist 30
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30"><defs><clipPath id="t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"></path></clipPath></defs><path d="M0,0 L60,30 M60,0 L0,30" stroke="#c8102e" stroke-width="4" clip-path="url(#t)" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

cross red {
  fly 27 6 27
  hoist 12 6 12
  fimbriate white 2
}
