// An invented flag exercising rotated bars and bands at other proportions: by scale when it's
// wider, where they still keep their widths, and by hoist-extend when it's narrower. A bend
// keeps the angle it had, and an edge keeps its start.
vexyl 1
meta {
  name "Rotated Adapt Scale Test"
}
palette {
  night "#1b1035"
  violet "#7b4fd6"
  gold "#f2c14e"
  white "#ffffff"
}
proportion hoist=20 fly=30

bars night violet {
  along fly
  rotate -12
  edge zigzag depth=2 count=4
}
bars none gold none {
  along bend-sinister
  ratio 2 1 3
  rotate 8
}
band white {
  along bend
  width 1.5
  offset 2
  rotate -25
  fimbriate night 0.5
}
band gold {
  along hoist
  width 1
  rotate 30
  anchor start
}
adapt {
  wider scale
  narrower hoist-extend
}
